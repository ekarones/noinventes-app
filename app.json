{
  "expo": {
    "name": "No inventes",
    "slug": "stockly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockly.app"
    },
    "android": {
      "package": "com.stockly.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite el acceso a la cámara para escanear códigos QR y tomar fotos de productos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite el acceso a tus fotos para subir imágenes de productos.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "Permite guardar en tu galería el código QR de un producto.",
          "savePhotosPermission": "Permite guardar en tu galería el código QR de un producto.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "owner": "mizonaonline",
    "extra": {
      "eas": {
        "projectId": "348db70d-c701-4722-8c43-27d3fd5e6af0"
      }
    }
  }
}
